{
  "name": "learndo-ui",
  "version": "1.0.0",
  "description": "Vue3 components library",
  "type": "module",
  "main": "dist/learndo-ui.umd.cjs",
  "module": "dist/learndo-ui.js",
  "exports": {
    ".": {
      "import": "./dist/learndo-ui.js",
      "require": "./dist/learndo-ui.umd.cjs"
    }
  },
  "types": "types/index.d.ts",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "vitest",
    "prepare": "husky",
    "commit": "git-cz",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "Vue3",
    "Components",
    "UI"
  ],
  "license": "MIT",
  "author": "chengbotao <chengbotao5221@163.com>",
  "contributors": [
    {
      "name": "chengbotao",
      "email": "chengbotao5221@163.com",
      "url": "https://chengbotao.github.io/chengbotao/"
    }
  ],
  "homepage": "https://chengbotao.github.io/learndo-ui/",
  "repository": "https://github.com/chengbotao/learndo-ui/tree/develop",
  "files": [
    "dist",
    "types"
  ],
  "peerDependencies": {
    "vue": ">=3.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@testing-library/vue": "^8.1.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "classnames": "^2.5.1",
    "commitizen": "^4.3.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "prettier": "3.4.2",
    "sass": "^1.89.0",
    "sass-embedded": "^1.89.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.4",
    "vue": "^3.5.15",
    "vue-tsc": "^2.2.10"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
